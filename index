<script>
/* ── i18n ──────────────────────────────────────────────── */
const T = {
  en: {
    hdr_sub:'Digital Documents', h_eyebrow:'Welcome back',
    h_tag1:'Brazilian Citizen', h_tag2:'4 Documents Active',
    h_sec1:'My Documents', h_sec2:'Notice',
    d_cnh:'Driver License', d_rg:'Identity Card',
    d_pass_lbl:'Passport', d_pass:'Passaporte',
    d_cpf:'Tax Registry', d_active:'Active',
    ib_title:'Secure Digital Wallet',
    ib_body:'Documents are stored locally on this device. Tap any card to view or present your document.',
    p_nation:'Brazilian Citizen', p_verified:'Verified Identity',
    p_sec1:'Personal Information', p_id_hdr:'Identification',
    p_fullname:'Full Name', p_dob:'Date of Birth',
    p_sex:'Sex', p_sex_v:'Male',
    p_nat:'Nationality', p_pob:'Place of Birth',
    p_sec2:'Document Numbers', p_docs_hdr:'Registry',
    p_pass_lbl:'Passport', p_sec3:'Filiation',
    p_fil_hdr:'Parents', p_father:'Father', p_mother:'Mother',
    n_home:'Home', n_pass:'Passport', n_profile:'Profile',
  },
  pt: {
    hdr_sub:'Documentos Digitais', h_eyebrow:'Bem-vindo(a)',
    h_tag1:'Cidadao Brasileiro', h_tag2:'4 Documentos Ativos',
    h_sec1:'Meus Documentos', h_sec2:'Aviso',
    d_cnh:'Carteira de Habilitacao', d_rg:'Carteira de Identidade',
    d_pass_lbl:'Passaporte', d_pass:'Passaporte',
    d_cpf:'Cadastro de Pessoa Fisica', d_active:'Ativo',
    ib_title:'Carteira Digital Segura',
    ib_body:'Documentos armazenados localmente neste dispositivo. Toque em qualquer cartao para visualizar.',
    p_nation:'Cidadao Brasileiro', p_verified:'Identidade Verificada',
    p_sec1:'Informacoes Pessoais', p_id_hdr:'Identificacao',
    p_fullname:'Nome Completo', p_dob:'Data de Nascimento',
    p_sex:'Sexo', p_sex_v:'Masculino',
    p_nat:'Nacionalidade', p_pob:'Naturalidade',
    p_sec2:'Numeros de Documentos', p_docs_hdr:'Registro',
    p_pass_lbl:'Passaporte', p_sec3:'Filiacao',
    p_fil_hdr:'Pais', p_father:'Pai', p_mother:'Mae',
    n_home:'Inicio', n_pass:'Passaporte', n_profile:'Perfil',
  }
};
function setLang(l) {
  document.getElementById('btn-en').classList.toggle('on', l==='en');
  document.getElementById('btn-pt').classList.toggle('on', l==='pt');
  const t = T[l];
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if (t[k] != null) el.textContent = t[k];
  });
}

/* ── Navigation ────────────────────────────────────────── */
let activeDoc = null;

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('on'));
  document.getElementById('s-' + id).classList.add('on');
}
function navTo(id, btn) {
  showScreen(id);
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('on'));
  btn.classList.add('on');
  activeDoc = null;
}
function openDoc(id) {
  showScreen(id);
  activeDoc = id;
  setSlide(id, 0);
}
function closeDoc() {
  showScreen('home');
  document.querySelectorAll('.ni').forEach(n => n.classList.remove('on'));
  document.querySelector('.ni[data-screen="home"]').classList.add('on');
  activeDoc = null;
}

/* ── Swipe Viewer ──────────────────────────────────────── */
const V = {
  cnh:      { n: 4, cur: 0 },
  rg:       { n: 2, cur: 0 },
  cpf:      { n: 2, cur: 0 },
  passport: { n: 2, cur: 0 }
};

function buildDots(id) {
  const v = V[id];
  const c = document.getElementById('dt-' + id);
  c.innerHTML = '';
  for (let i = 0; i < v.n; i++) {
    const d = document.createElement('div');
    d.className = 'vdot' + (i===0?' on':'');
    d.onclick = () => setSlide(id, i);
    c.appendChild(d);
  }
}
function setSlide(id, i) {
  const v = V[id];
  v.cur = Math.max(0, Math.min(i, v.n - 1));
  const sl = document.getElementById('sl-' + id);
  if (sl) sl.style.transform = `translateX(-${v.cur * 100}%)`;
  document.querySelectorAll(`#dt-${id} .vdot`).forEach((d,j) =>
    d.classList.toggle('on', j===v.cur));
  const pi = document.getElementById('pi-' + id);
  if (pi) pi.textContent = `${v.cur+1} / ${v.n}`;
}
function initSwipe(id) {
  const area = document.getElementById('sw-' + id);
  if (!area) return;
  let x0=0, y0=0;
  area.addEventListener('touchstart', e => {
    x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
  }, {passive:true});
  area.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - x0;
    const dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 38) {
      setSlide(id, V[id].cur + (dx < 0 ? 1 : -1));
    }
  }, {passive:true});
}

Object.keys(V).forEach(id => { buildDots(id); initSwipe(id); });

document.addEventListener('keydown', e => {
  if (!activeDoc) return;
  if (e.key==='ArrowRight') setSlide(activeDoc, V[activeDoc].cur+1);
  if (e.key==='ArrowLeft')  setSlide(activeDoc, V[activeDoc].cur-1);
  if (e.key==='Escape')     closeDoc();
});
</script>
